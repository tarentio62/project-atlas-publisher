# Required
GITHUB_USERNAME=your_github_username
# Optional if `gh` CLI is already logged in (recommended). If USE_GH_CLI=0, this becomes required.
GITHUB_TOKEN=github_pat_xxx

# If using Gemini
GEMINI_API_KEY=AIzaSy...

# Optional
ROOT_PROJECTS_DIR=C:\\Users\\nicol\\Documents\\projets perso
WORKDIR=github_workspace

# Repository names (choose a coherent branding)
SHOWCASE_REPO_NAME=dev-portfolio-index
ARCHIVE_REPO_NAME=dev-project-vault

# Keep client work private (case-insensitive substring match against project folder name)
CLIENT_PROJECT_KEYWORDS=siyour,signee,mse,generali,prive,concierge,mfr,aplon

# Optional: gitleaks binary path
GITLEAKS_PATH=tools\\bin\\gitleaks.exe

# Publishing policy
# - llm: only public when Gemini recommends it
# - safe: public when gitleaks is clean and not a client project (Gemini optional)
PUBLIC_POLICY=llm
ALLOW_PUBLIC=1

# Prefer GitHub CLI auth (recommended)
USE_GH_CLI=1
